{
  "name": "@wowyuarm/dsh-context-continuity",
  "version": "0.2.0",
  "description": "A subject's context lived as one continuous timeline across many physical Sessions: rollover, checkpoints, and lineage.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wowyuarm/dsh-plugins.git",
    "directory": "packages/context-continuity"
  },
  "keywords": [
    "context-continuity",
    "context-management",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session-management",
    "rollover",
    "checkpoints"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run check:boundaries && vitest run",
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-compaction": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-session-persistence": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-session-projection": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-session-query": ">=0.2.0-rc.1 <0.2.1",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.2.1",
    "@wowyuarm/dsh-jev": "^0.1.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session-query": {
      "optional": true
    },
    "@wowyuarm/dsh-jev": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.1",
    "@deepseek-ai/dsh-compaction": "0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session-persistence": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session-query": "0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.1",
    "@types/node": "^24.0.0",
    "@wowyuarm/dsh-jev": "0.1.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
