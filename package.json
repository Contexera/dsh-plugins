{
  "name": "@contexera/dsh-plugins",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for published DeepSeek Harness plugins under the @wowyuarm scope.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "check:peers": "node scripts/check-dsh-peers.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm -r build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3"
  }
}
